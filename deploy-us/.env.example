# ── 美服 OpenIM 基础组件配置模板（deploy-us）──
# 用法：cp .env.example .env，再把下面的 CHANGE_ME 改成强密码。
# .env 含真实密码、已被 .gitignore 忽略，不要提交入库。
# 镜像版本与国服对齐
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:7.0.0
# ⚠️ bitnami 2025 年将 docker hub 免费镜像迁至 bitnamilegacy，原 bitnami/kafka:3.5.1 已 404（内容一致、KAFKA_CFG_* 变量兼容）
KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.13
AUTOHEAL_IMAGE=willfarrell/autoheal:latest
# openim-server / openim-chat 预置镜像 tag（build-and-save.sh 用同一个；生产机 load 后 compose 引用它）
IMAGE_TAG=us

# 数据目录（★ 放在 git 仓库外，避免 mongo 数据落进 /dl/OpenIM 工作树被 git clean 误删/撑大仓库）
DATA_DIR=/dl/openim-data
MONGO_BACKUP_DIR=${DATA_DIR}/components/backup/mongo/

# 时区：美西（和业务 America/Los_Angeles 对齐）
TZ=America/Los_Angeles

# ⚠️ 部署前务必改成美服专属强密码（别沿用国服 openIM123）
# 改完后同步 patch-config.sh 里的同名变量，保证 OpenIM/Chat 配置一致
# ⚠️ 密码别含 $ 空格 引号 反斜杠 —— 本文件同时被 docker compose 和 shell（backup-mongo.sh）解析，特殊字符两边行为不一致
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_root
MONGO_OPENIM_PASSWORD=CHANGE_ME_mongo_openim
REDIS_PASSWORD=CHANGE_ME_redis
